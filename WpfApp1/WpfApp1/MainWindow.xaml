<Window x:Class="DocxLetterGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:berry="clr-namespace:Berry.DocxViewer;assembly=Berry.DocxViewer"
        Title="Генератор писем"
        Height="1000" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                           Text="Генерация письма"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#E8E8E8" Padding="5" Margin="0,5,0,5">
                    <TextBlock Text="Информация отправителя" FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Корпорация:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Corporation" Margin="0,0,0,5" Height="28" Text="Акционерное общество «Пролетарский прогресс»"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="ООО/Юр. лицо:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="LLC" Margin="0,0,0,5" Height="28" Text="АО «Пролетарский прогресс»"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Телефон:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="Telephone" Margin="0,0,0,5" Height="28" Text="(495) 123-44-55"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Факс:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="Fax" Margin="0,0,0,5" Height="28" Text="(495) 123-44-56"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="Email" Margin="0,0,0,5" Height="28" Text="info@company.ru"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="ОКПО:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="OKPO" Margin="0,0,0,5" Height="28" Text="64609789"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="ОГРН:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="OGRN" Margin="0,0,0,5" Height="28" Text="1097654389076"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="ИНН:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="INN" Margin="0,0,0,5" Height="28" Text="7701234567"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="КПП:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="KPP" Margin="0,0,0,5" Height="28" Text="770605405"/>

                <Border Grid.Row="11" Grid.ColumnSpan="2" Background="#E8E8E8" Padding="5" Margin="0,10,0,5">
                    <TextBlock Text="Информация получателя" FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Корпорация получателя:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="12" Grid.Column="1" x:Name="RecipientCorp" Margin="0,0,0,5" Height="28" Text="ООО «Партнёр»"/>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="Должность получателя:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="13" Grid.Column="1" x:Name="RecipientPostBox" Margin="0,0,0,5" Height="28" Text="Генеральному директору"/>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="Имя получателя:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="14" Grid.Column="1" x:Name="RecipientNameBox" Margin="0,0,0,5" Height="28" Text="Иванову И.И."/>

                <Border Grid.Row="15" Grid.ColumnSpan="2" Background="#E8E8E8" Padding="5" Margin="0,10,0,5">
                    <TextBlock Text="Содержание письма" FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Row="16" Grid.Column="0" Text="Тема:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="16" Grid.Column="1" x:Name="SubjectBox" Margin="0,0,0,5" Height="28" Text="Предложение о сотрудничестве"/>

                <TextBlock Grid.Row="17" Grid.Column="0" Text="Текст письма:" VerticalAlignment="Top"/>
                <TextBox Grid.Row="17" Grid.Column="1" x:Name="BodyBox" 
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="120" Margin="0,0,0,5" 
                         Text="Уважаемый Иван Иванович!&#x0A;&#x0A;Предлагаем вам рассмотреть наше коммерческое предложение.&#x0A;&#x0A;С уважением, руководство"/>

                <Border Grid.Row="18" Grid.ColumnSpan="2" Background="#E8E8E8" Padding="5" Margin="0,10,0,5">
                    <TextBlock Text="Подпись" FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Row="19" Grid.Column="0" Text="Должность отправителя:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="19" Grid.Column="1" x:Name="SenderPosition" Margin="0,0,0,5" Height="28" Text="Генеральный директор"/>

                <TextBlock Grid.Row="20" Grid.Column="0" Text="Имя отправителя:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="20" Grid.Column="1" x:Name="SenderName" Margin="0,0,0,5" Height="28" Text="Петров П.П."/>

                <Button Grid.Row="21" Grid.ColumnSpan="2" 
                        Content="Сгенерировать документ"
                        Width="200" Height="40"
                        Click="GenerateButton_Click"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,5"
                        Background="LightGreen"/>

                <TextBlock Grid.Row="22" Grid.ColumnSpan="2" 
                           x:Name="StatusText"
                           Text="Готов"
                           Foreground="Green"
                           HorizontalAlignment="Center"
                           Margin="0,5"/>

                <TextBlock Grid.Row="23" Grid.ColumnSpan="2" 
                           Text="══════════════════════════════"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,5"/>

                <Border Grid.Row="24" Grid.ColumnSpan="2" Background="#E8E8E8" Padding="5" Margin="0,5,0,5">
                    <TextBlock Text="Приложения" FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Row="25" Grid.Column="0" Text="Заголовок:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="25" Grid.Column="1" x:Name="AppendixTitleBox" Margin="0,0,0,5" Height="28"/>

                <TextBlock Grid.Row="26" Grid.Column="0" Text="Текст:" VerticalAlignment="Top"/>
                <TextBox Grid.Row="26" Grid.Column="1" x:Name="AppendixTextBox" 
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="80" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="27" Grid.Column="0" Text="Листов:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="27" Grid.Column="1" x:Name="AppendixPagesBox" Margin="0,0,0,5" Height="28"/>

                <StackPanel Grid.Row="28" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                    <Button Content="Добавить" Click="AddAppendixButton_Click" Width="100" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Удалить" Click="RemoveAppendixButton_Click" Width="100" Height="30"/>
                </StackPanel>

                <DataGrid Grid.Row="29" Grid.ColumnSpan="2"
                          x:Name="AppendicesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          Height="150"
                          Margin="0,5,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                        <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Листы" Binding="{Binding Pages}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Предпросмотр документа"
                           FontWeight="Bold" FontSize="14"
                           Padding="10"
                           Background="#F0F0F0"/>

                <berry:DocxViewer x:Name="DocPreview" Grid.Row="1" Margin="5"/>
            </Grid>
        </Border>
    </Grid>
</Window>